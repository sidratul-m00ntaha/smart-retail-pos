# ============================================================
# Docker settings for the local SQL Server.
# 1. Copy this file and name the copy ".env"  (same folder)
# 2. Change the password in .env to your own
# .env is ignored by Git - never commit it.
# ============================================================

# SQL Server "sa" (admin) password. Rules:
#  - at least 8 characters
#  - must contain uppercase, lowercase, a number AND a symbol
#  - use only letters, numbers, and _ or - or ! as symbols
#    (avoid $ # @ % " ' and spaces - they break config files and URLs)
MSSQL_SA_PASSWORD=Change_Me_Pos2026

# Port on your computer. Change to 1434 only if 1433 is already
# used by a SQL Server installed directly on your computer.
MSSQL_PORT=1433