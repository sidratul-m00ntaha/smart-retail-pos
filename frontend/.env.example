# ============================================================
# Frontend settings.
# 1. Copy this file and name the copy ".env"  (inside frontend/)
# 2. Restart "npm run dev" after changing it.
#
# WARNING: everything in this file is visible to anyone who opens
# the website. NEVER put passwords or API keys (like the AI key)
# here - secrets belong in backend/.env only.
# Only variables starting with VITE_ are available to React code.
# ============================================================

# Address of the FastAPI backend
VITE_API_BASE_URL=http://127.0.0.1:8000