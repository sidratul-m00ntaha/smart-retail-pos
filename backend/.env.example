# ============================================================
# Backend settings.
# 1. Copy this file and name the copy ".env"  (inside backend/)
# 2. Set DB_PASSWORD to the SAME password as MSSQL_SA_PASSWORD
#    in the .env file at the top of the project.
# .env is ignored by Git - never commit it.
# ============================================================

# ---- Database (the SQL Server running in Docker) ----
DB_SERVER=127.0.0.1
DB_PORT=1433
DB_NAME=smart_retail_pos
DB_USER=sa
DB_PASSWORD=Change_Me_Pos2026
DB_DRIVER=ODBC Driver 18 for SQL Server

# ---- Frontend address allowed to call the API (comma-separated) ----
CORS_ORIGINS=http://localhost:5173

# ---- First admin account (created by: python -m app.init_db) ----
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=Change_Me_Admin2026